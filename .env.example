# ─────────────────────────────────────────────────────────────────────
# NAOMI — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Database connection URL (defaults to zero-setup local SQLite in data/naomi.db)
# For local development: no configuration is needed.
#
# For production PostgreSQL (asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://naomi:naomi_pass@localhost:5432/naomi_db
